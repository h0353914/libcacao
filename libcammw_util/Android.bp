// libcammw_util —— 從零重建版，完整取代 Sony 原廠的 libcammw_util.so。
//
// 為什麼要重建：原廠版的 cammw_util_shmem_detach_image_buf 在
// gralloc1_release 失敗時不會 close 掉 attach 時 dup 出來的兩個 dmabuf fd
// （它用 `rc < 0` 判斷失敗，但 gralloc1_error_t 全是非負值，拒收被當成
// 成功），開關相機十幾次就累積到 2600+ 個 fd / 2GB dmabuf，最後整台
// 記憶體耗盡、相機開不起來。重建版在 detach 補上這個 close。
//
// 這顆直接以 libcammw_util 的名字安裝，所以原廠 blob 以及先前改名保留的
// libcammw_util_real.so 都不再需要，libexcal_core.so 也維持原廠未修改的
// DT_NEEDED（只有 libcammw_util.so），extract-files.py 不需要任何 fixup。
//
// 重要：attach 建 private_handle_t 時 numInts 填 kGrallocNumInts（本機
// gralloc 的 NumInts()，A15 上是 24）。CAF 2019 的 ImportHandleLocked()
// 會把 size/offset 覆寫成「整塊 dmabuf / 0」，所以 retain 之後要把那三個
// 欄位寫回去，否則 chroma plane 讀到沒寫過的記憶體、拍出來整張全綠。
// 詳見 src/shmem.cpp 內的註解。

cc_library_shared {
    name: "libcammw_util",
    stem: "libcammw_util",

    srcs: ["src/*.cpp"],
    local_include_dirs: ["include"],

    shared_libs: [
        "liblog",
        "libcutils",
        "libhardware",
    ],

    version_script: "cammw_util.map",

    vendor: true,
    compile_multilib: "32",
    stl: "libc++",
}
