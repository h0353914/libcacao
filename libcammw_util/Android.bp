// libcammw_util —— 從零重建版，完整取代 Sony 原廠的 libcammw_util.so。
//
// 為什麼要重建：原廠版的 cammw_util_shmem_detach_image_buf 在
// gralloc1_release 失敗時不會 close 掉 attach 時 dup 出來的兩個 dmabuf fd
// （它用 `rc < 0` 判斷失敗，但 gralloc1_error_t 全是非負值，拒收被當成
// 成功），開關相機十幾次就累積到 2600+ 個 fd / 2GB dmabuf，最後整台
// 記憶體耗盡、相機開不起來。重建版在 detach 補上這個 close。
//
// 這顆直接以 libcammw_util 的名字安裝，所以原廠 blob 以及先前改名保留的
// libcammw_util_real.so 都不再需要，libexcal_core.so 也維持原廠未修改的
// DT_NEEDED（只有 libcammw_util.so），extract-files.py 不需要任何 fixup。
//
// 重要：attach 直接用本機 gralloc 的 private_handle_t 建構子建 handle
// （numInts 等欄位由它填）。CAF 2019 的 ImportHandleLocked() 會把
// size/offset/offset_metadata 覆寫成「整塊 dmabuf / 0」，所以 retain 之後
// 要把那三個欄位寫回去，否則 chroma plane 讀到沒寫過的記憶體、拍出來
// 整張全綠。詳見 src/shmem.cpp 內的註解。

cc_library_shared {
    name: "libcammw_util",
    stem: "libcammw_util",

    srcs: ["src/*.cpp"],
    local_include_dirs: ["include"],

    // 直接用建置目標的 gralloc private_handle_t 定義，不自己複製一份佈局。
    // 這顆只在 A15（Soong）建置，所以拿到的一定是這棵樹的 gralloc 標頭；
    // numInts / magic / layer_count 等欄位交給它的建構子填，CAF 改佈局時
    // 會自動跟著對。
    include_dirs: ["hardware/qcom-caf/msm8998/display/gralloc"],

    shared_libs: [
        "liblog",
        "libcutils",
        "libhardware",
    ],

    version_script: "cammw_util.map",

    vendor: true,
    compile_multilib: "32",
    stl: "libc++",
}
