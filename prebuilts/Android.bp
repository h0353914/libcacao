// Sony 專有函式庫 prebuilt（libcacao_process_ctrl_gateway_real 依賴）

cc_prebuilt_library_shared {
    name: "libcacao_pal",
    stem: "libcacao_pal",

    compile_multilib: "both",
    arch: {
        arm: {
            srcs: ["lib/libcacao_pal.so"],
        },
        arm64: {
            srcs: ["lib64/libcacao_pal.so"],
        },
    },

    strip: { none: true },
    check_elf_files: false,
    prefer: true,
    stl: "none",

    // System (default): cacaoserver and its whole libcacao_* chain are
    // system-side again (see libcacao_service/Android.bp), so libcacao_pal
    // no longer needs to be dual-available.
    vendor: false,
    vendor_available: false,
    product_specific: false,
    product_available: false,
}

// vendor.somc.hardware.camera.{provider@1.0,cacao@3.0,cacao@3.1} intentionally
// not (re)defined here: on the device tree this branch is actually built
// against (vendor/sony/camera, wired into yoshino-common), those exact same
// prebuilt blobs are already defined there and reused as-is by
// libcacao_process_ctrl_gateway/libcacao_service (now marked
// vendor_available in yoshino-common so system-side cacaoserver can reach
// them too — see the comment there). Defining them again here would just be
// a same-name duplicate module conflict.