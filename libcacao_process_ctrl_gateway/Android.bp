// libcacao_process_ctrl_gateway — ProcessCtrlGateway 實作
// 依照 libcacao_process_ctrl_gateway.so 反編譯結果重建

cc_library_headers {
    name: "libcacao_process_ctrl_gateway_headers",

    defaults: ["libcacao_common_defaults"],

    export_include_dirs: ["include"],
}

cc_library_shared {
    name: "libcacao_process_ctrl_gateway",
    stem: "libcacao_process_ctrl_gateway",

    defaults: ["libcacao_32bit_build_defaults"],

    // System (default): see libcacao_service/Android.bp for why cacaoserver
    // and this whole chain stay system-side now instead of vendor:true.
    srcs: [
        "src/ProcessCtrlGatewayBase.cpp",
        "src/ProcessCtrlGateway.cpp",
        "src/aeabi_helpers.c",
    ],

    header_libs: [
        "libcacao_process_ctrl_gateway_headers",
    ],

    shared_libs: [
        "android.hidl.base@1.0",
        "android.hidl.manager@1.0",
        "android.hardware.camera.common@1.0",
        "android.hardware.graphics.allocator@2.0",
        "libhidlbase",
        "libutils",
        "libbinder",
        "libgui",
        "liblog",
        "libcutils",
        "libcacao_pal",
        "libcacao_client",
        "vendor.somc.hardware.camera.provider@1.0",
        "vendor.somc.hardware.camera.cacao@3.0",
        "vendor.somc.hardware.camera.cacao@3.1",
    ],

    cflags: [
        "-mllvm",
        "-rotation-max-header-size=0",
        "-DLIBCACAO_SOONG_BUILD",
        "-DLIBCACAO_USE_LINEAGE14_HEADERS",
    ],

    version_script: "libcacao_process_ctrl_gateway.map.txt",
}
