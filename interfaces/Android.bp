// vendor.somc.hardware.camera.* 的 HIDL interface 定義，反推自
// vendor.somc.hardware.camera.cacao@{1.0,2.0,3.0,3.1}.so 與
// vendor.somc.hardware.camera.provider@1.0.so（詳見各 .hal 檔案內註解）。
//
// 2026-08-19：cacao@3.0 驗證通過後，其餘 5 個介面（cacao@1.0/2.0/3.1、
// device@1.0、provider@1.0）也一併換成 hidl-gen 生成版。yoshino-common
// 裡原本的 cc_prebuilt_library_shared 全部改名成 <name>_vendor_blob
// （stem 保留原檔名、vendor: true），只留給 vendor 分區真正在跑的 cald
// 服務鏈（cacao@3.0-impl、provider@1.0-service）使用；system 分區一律
// 改用這裡建出來的版本，因此不再需要 libhidlbase_shim。

hidl_package_root {
    name: "vendor.somc.hardware.camera",
    path: "vendor/sony/camera/cacao/interfaces/vendor/somc/hardware/camera",
}

// 2026-08-18：本來想用 hidl_interface 直接從 .hal 生成，但 Soong 幫這個
// genrule 算 dep file（.d）路徑時，在這種巢狀目錄結構下會算出重複一層
// 的子路徑（從沒被建出來），導致 hidl-gen 寫 .d 檔失敗——header/source
// 本身其實有正確生成，純粹是這個輔助檔案的路徑算錯，屬於
// system/tools/hidl 這個 Soong 外掛本身的邊角案例 bug，不是我們的
// .hal 或設定有問題（已用完全相同的 hidl-gen 指令手動執行驗證過，
// exit 0，產出檔案內容正確）。
//
// 繞過方式：改成手動離線跑 hidl-gen 產生一次 C++ 程式碼，把產物直接
// check-in 進 interfaces/generated/，用一般的 cc_library_shared 編譯——
// 不再經過 hidl_interface 那個壞掉的 genrule。之後改了 .hal 需要記得手動
// 重跑（注意 -r 的路徑 hidl-gen 是相對 build top 解析的，不是相對 cwd，
// 所以這裡一律用絕對路徑；-o 才是相對 cwd，要在 interfaces/ 這層執行，
// 產物才會落在 interfaces/generated/，跟下面 srcs 的相對路徑對得上）：
//   I=<這個 interfaces 目錄的絕對路徑>
//   cd $I && rm -rf generated && \
//   hidl-gen -Lc++-headers -o generated \
//     -r vendor.somc.hardware.camera:$I/vendor/somc/hardware/camera \
//     -r android.hardware:$ANDROID_BUILD_TOP/hardware/interfaces \
//     -r android.hidl:$ANDROID_BUILD_TOP/system/libhidl/transport \
//     <package>
//   （-Lc++-sources 同樣參數再跑一次）
//   <package> 需逐一跑過下列 6 個：
//     vendor.somc.hardware.camera.cacao@{1.0,2.0,3.0,3.1}
//     vendor.somc.hardware.camera.device@1.0
//     vendor.somc.hardware.camera.provider@1.0
//   （注意 rm -rf generated 只在跑第一個 package 前做一次）
// 六個 HIDL 介面庫共用的設定。全部 32-bit only（對應原廠 blob 只有
// /vendor/lib 的 arm 版）。
//
// 2026-08-21：加上 vendor_available: true，讓 Soong 額外建一份 vendor
// variant，取代 yoshino-common 裡改名成 *_vendor_blob 的原廠 prebuilt，
// 讓 cald（provider@1.0-service）、cacao@3.0-impl 這些 vendor 分區的
// 常駐服務也能直接用這裡重建的版本。
//
// 起因：先把 system 變體的 .so 直接手動塞進 /vendor/lib 測試過，
// cald 立刻進 linker 失敗重啟迴圈——
//   CANNOT LINK EXECUTABLE ...: library "android.hidl.manager@1.0.so"
//   not found ... in namespace (default)
// 原因是 system 變體連結到的是 android.hidl.manager@1.0 的 *system*
// 版本，Treble 的 vendor linker namespace 看不到它。真正要讓 vendor
// 分區能用，必須讓 Soong 對這幾個 module 額外生成 vendor variant（別
// 只是手動搬檔案），這樣 shared_libs 列的 android.hidl.base@1.0 /
// android.hidl.manager@1.0 / libhidlbase / libhidltransport /
// libhwbinder 才會各自解析到它們自己的 vendor variant——這幾個全部
// 確認過本來就是 vendor_available:true（android.hidl.*@1.0 是
// hidl_interface 生成、libhidlbase/libhidltransport/libhwbinder 在
// system/libhidl、system/libhwbinder 的 Android.bp 裡明寫
// vendor_available: true），所以只差我們自己這層沒開。
cc_defaults {
    name: "somc_camera_hidl_defaults",
    owner: "sony",
    vendor_available: true,

    export_include_dirs: ["generated"],

    shared_libs: [
        "android.hidl.base@1.0",
        "android.hidl.manager@1.0",
        "libhidlbase",
        "libhidltransport",
        "libhwbinder",
        "liblog",
        "libutils",
        "libcutils",
    ],

    export_shared_lib_headers: [
        "android.hidl.base@1.0",
        "libhidlbase",
    ],

    cflags: [
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
    ],

    compile_multilib: "32",
}

// [未研究] 空介面。只為了讓 provider@1.0 的 getCacaoInterface_V1_0()
// 有型別可回傳，libcacao_service 從未實際呼叫。詳見 .hal 內註解。
cc_library_shared {
    name: "vendor.somc.hardware.camera.cacao@1.0",
    defaults: ["somc_camera_hidl_defaults"],

    srcs: [
        "generated/vendor/somc/hardware/camera/cacao/1.0/CacaoAll.cpp",
    ],
}

// [未研究] 空介面，理由同 @1.0。
cc_library_shared {
    name: "vendor.somc.hardware.camera.cacao@2.0",
    defaults: ["somc_camera_hidl_defaults"],

    srcs: [
        "generated/vendor/somc/hardware/camera/cacao/2.0/CacaoAll.cpp",
    ],
}

cc_library_shared {
    name: "vendor.somc.hardware.camera.cacao@3.0",
    defaults: ["somc_camera_hidl_defaults"],

    srcs: [
        "generated/vendor/somc/hardware/camera/cacao/3.0/types.cpp",
        "generated/vendor/somc/hardware/camera/cacao/3.0/CacaoAll.cpp",
        "generated/vendor/somc/hardware/camera/cacao/3.0/CacaoCallbackAll.cpp",
    ],
}

// 繼承 @3.0::ICacao（code 1-10 沿用），只新增 code 11 getCapsV3_1。
cc_library_shared {
    name: "vendor.somc.hardware.camera.cacao@3.1",
    defaults: ["somc_camera_hidl_defaults"],

    srcs: [
        "generated/vendor/somc/hardware/camera/cacao/3.1/types.cpp",
        "generated/vendor/somc/hardware/camera/cacao/3.1/CacaoAll.cpp",
    ],

    shared_libs: [
        "vendor.somc.hardware.camera.cacao@3.0",
    ],

    export_shared_lib_headers: [
        "vendor.somc.hardware.camera.cacao@3.0",
    ],
}

// [未研究] 空介面。只為了讓 provider@1.0 的
// getCameraExtensionDeviceInterface_V1_0() 有型別可回傳。
cc_library_shared {
    name: "vendor.somc.hardware.camera.device@1.0",
    defaults: ["somc_camera_hidl_defaults"],

    srcs: [
        "generated/vendor/somc/hardware/camera/device/1.0/CameraExtensionDeviceAll.cpp",
    ],
}

// 真的繼承 android.hardware.camera.provider@2.4::ICameraProvider
// （code 1-6），自己新增 code 7-10。
cc_library_shared {
    name: "vendor.somc.hardware.camera.provider@1.0",
    defaults: ["somc_camera_hidl_defaults"],

    srcs: [
        "generated/vendor/somc/hardware/camera/provider/1.0/VendorSomcCameraProviderAll.cpp",
    ],

    shared_libs: [
        "android.hardware.camera.common@1.0",
        "android.hardware.camera.device@1.0",
        "android.hardware.camera.device@3.2",
        "android.hardware.camera.provider@2.4",
        "vendor.somc.hardware.camera.cacao@1.0",
        "vendor.somc.hardware.camera.cacao@2.0",
        "vendor.somc.hardware.camera.cacao@3.0",
        "vendor.somc.hardware.camera.device@1.0",
    ],

    export_shared_lib_headers: [
        "android.hardware.camera.common@1.0",
        "android.hardware.camera.provider@2.4",
        "vendor.somc.hardware.camera.cacao@1.0",
        "vendor.somc.hardware.camera.cacao@2.0",
        "vendor.somc.hardware.camera.cacao@3.0",
        "vendor.somc.hardware.camera.device@1.0",
    ],
}
